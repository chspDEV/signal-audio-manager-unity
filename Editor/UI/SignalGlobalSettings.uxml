<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:ScrollView class="tab-scroll-view">
        
        <ui:VisualElement class="section-container">
            <ui:Label text="Audio Mixer Configuration" class="section-header" />
            <uie:PropertyField binding-path="audioMixer" label="Main Audio Mixer" />
            <uie:PropertyField binding-path="masterVolumeParam" label="Master Volume Param" />
            <uie:PropertyField binding-path="musicVolumeParam" label="Music Volume Param" />
            <uie:PropertyField binding-path="sfxVolumeParam" label="SFX Volume Param" />
            <uie:PropertyField binding-path="uiVolumeParam" label="UI Volume Param" />
        </ui:VisualElement>

        <ui:VisualElement class="section-container">
            <ui:Label text="Asset References" class="section-header" />
            <uie:PropertyField binding-path="sfxPrefab" label="SFX Audio Source Prefab" />
        </ui:VisualElement>

        <ui:VisualElement class="section-container">
            <ui:Label text="General Settings" class="section-header" />
            <uie:PropertyField binding-path="maxSimultaneousMusic" label="Max Simultaneous Music" />
            <uie:PropertyField binding-path="sfxPoolSize" label="SFX Pool Size" />
        </ui:VisualElement>
        
        <ui:VisualElement class="section-container" style="margin-top: 20px;">
            <ui:Label text="💻 Code Generation (Strongly Typed API)" class="section-header" style="color: #4ec9b0;" />
            <ui:Label text="Generate a C# script containing all your Audio IDs as constants. This prevents typos and enables IDE autocomplete." class="help-text" />
    
            <ui:Label text="Example: Signal.PlaySFX(AudioKeys.SFX.my_sound_id);" class="help-text" style="color: #dcdcaa; -unity-font-style: italic; margin-top: 5px; background-color: rgba(0, 0, 0, 0.2); padding: 4px; border-radius: 4px;" />
    
            <ui:VisualElement style="align-items: flex-end; margin-top: 10px;">
                <ui:Button name="btn-generate-keys" text="Generate AudioKeys" class="setup-btn" style="background-color: #2b5c50;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:ScrollView>
</ui:UXML>