<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:ScrollView class="tab-scroll-view">
        <ui:VisualElement class="section-container">
            <ui:Label text="📖 Quick Start Guide" class="section-header" style="font-size: 18px; color: rgb(157, 114, 245);"/>
            <ui:Label text="1. Setup Data: Go to the Import Tools tab and drag your audio folders to automatically populate your Music and SFX libraries." class="help-text"/>
            <ui:Label text="2. Play Sounds via Code: Use the clean static API from anywhere in your game:" class="help-text"/>
            <ui:VisualElement style="background-color: rgb(30, 30, 30); padding: 10px; border-radius: 4px; margin-bottom: 15px;">
                <ui:Label text="Signal.PlaySFX(&quot;explosion&quot;);" style="color: rgb(78, 201, 176); -unity-font-style: bold; margin-bottom: 5px;"/>
                <ui:Label text="Signal.PlayMusic(&quot;main_theme&quot;, 2.0f); // with 2s crossfade" style="color: rgb(78, 201, 176); -unity-font-style: bold; white-space: normal;"/>
            </ui:VisualElement>
            <ui:Label text="3. Scene Setup (Auto-Magic): You don&apos;t need to drag the Audio_Managers prefab into your scenes anymore! Just call the code above, and Signal Audio will automatically spawn the manager if it&apos;s missing." class="help-text"/>
            <ui:VisualElement style="align-items: center; margin-top: 30px;">
                <ui:Button name="btn-open-pdf" text="📚 Open Full Documentation (PDF)" class="setup-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
