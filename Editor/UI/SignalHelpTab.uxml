<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:ScrollView class="tab-scroll-view">
        <ui:VisualElement class="section-container">
            
            <ui:Label text="📖 Quick Start Guide" class="section-header" style="font-size: 18px; color: rgb(157, 114, 245);"/>
            <ui:Label text="1. Setup Data: Go to the Import Tools tab and drag your audio folders to automatically populate your Music and SFX libraries." class="help-text"/>
            
            <ui:Label text="2. Play Sounds via Code: Use the clean static API from anywhere in your game:" class="help-text"/>
            <ui:VisualElement style="background-color: rgb(30, 30, 30); padding: 10px; border-radius: 4px; margin-bottom: 15px;">
                <ui:Label text="Signal.PlaySFX(&quot;explosion&quot;);" style="color: rgb(78, 201, 176); -unity-font-style: bold; margin-bottom: 5px;"/>
                <ui:Label text="Signal.PlayMusic(&quot;main_theme&quot;, 2.0f); // with 2s crossfade" style="color: rgb(78, 201, 176); -unity-font-style: bold; white-space: normal;"/>
            </ui:VisualElement>
            
            <ui:Label text="3. Scene Setup (Auto-Magic): You don't need to drag the Audio_Managers prefab into your scenes anymore! Just call the code above, and Signal Audio will automatically spawn the manager if it's missing." class="help-text" style="white-space: normal;" />
            
            <ui:Label text="⚡ API Cheat Sheet" class="section-header" style="font-size: 16px; color: #4ec9b0; margin-top: 25px; margin-bottom: 10px;"/>
            <ui:VisualElement style="border-width: 1px; border-color: #333333; border-radius: 6px; overflow: hidden; margin-bottom: 20px;">
                
                <ui:VisualElement style="flex-direction: row; background-color: #2d2d30; padding: 8px 10px; -unity-font-style: bold;">
                    <ui:Label text="Command" style="flex-grow: 1; width: 50%; color: #9d72f5;" />
                    <ui:Label text="Description" style="flex-grow: 1; width: 50%; color: #9d72f5;" />
                </ui:VisualElement>

                <ui:VisualElement style="flex-direction: row; background-color: #1e1e1e; padding: 8px 10px; border-bottom-width: 1px; border-bottom-color: #333333;">
                    <ui:Label text="Signal.PlaySFX(id)" style="flex-grow: 1; width: 50%; color: #dcdcaa; -unity-font-style: italic;" />
                    <ui:Label text="Plays a 2D sound effect." style="flex-grow: 1; width: 50%; color: #cccccc; white-space: normal;" />
                </ui:VisualElement>
                
                <ui:VisualElement style="flex-direction: row; background-color: #252526; padding: 8px 10px; border-bottom-width: 1px; border-bottom-color: #333333;">
                    <ui:Label text="Signal.PlaySFX(id, Vector3)" style="flex-grow: 1; width: 50%; color: #dcdcaa; -unity-font-style: italic;" />
                    <ui:Label text="Plays a 3D sound at a specific world position." style="flex-grow: 1; width: 50%; color: #cccccc; white-space: normal;" />
                </ui:VisualElement>
                
                <ui:VisualElement style="flex-direction: row; background-color: #1e1e1e; padding: 8px 10px; border-bottom-width: 1px; border-bottom-color: #333333;">
                    <ui:Label text="Signal.PlaySFX(id, Transform)" style="flex-grow: 1; width: 50%; color: #dcdcaa; -unity-font-style: italic;" />
                    <ui:Label text="Plays a 3D sound that follows a moving object." style="flex-grow: 1; width: 50%; color: #cccccc; white-space: normal;" />
                </ui:VisualElement>

                <ui:VisualElement style="flex-direction: row; background-color: #252526; padding: 8px 10px; border-bottom-width: 1px; border-bottom-color: #333333;">
                    <ui:Label text="Signal.PlayMusic(id, fade)" style="flex-grow: 1; width: 50%; color: #dcdcaa; -unity-font-style: italic;" />
                    <ui:Label text="Crossfades smoothly to a new music track." style="flex-grow: 1; width: 50%; color: #cccccc; white-space: normal;" />
                </ui:VisualElement>
                
                <ui:VisualElement style="flex-direction: row; background-color: #1e1e1e; padding: 8px 10px;">
                    <ui:Label text="Signal.PlayUI(id)" style="flex-grow: 1; width: 50%; color: #dcdcaa; -unity-font-style: italic;" />
                    <ui:Label text="Plays a clean 2D sound for menus/UI." style="flex-grow: 1; width: 50%; color: #cccccc; white-space: normal;" />
                </ui:VisualElement>

            </ui:VisualElement>

            <ui:VisualElement style="align-items: center; margin-top: 10px;">
                <ui:Button name="btn-open-pdf" text="📚 Open Full Documentation (PDF)" class="setup-btn" style="padding: 12px 24px; font-size: 14px;" />
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>