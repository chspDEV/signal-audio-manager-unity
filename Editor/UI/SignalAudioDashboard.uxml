<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    
    <ui:VisualElement name="welcome-screen" class="welcome-screen">
        <ui:Label text="Welcome to Signal Audio Manager" class="welcome-title" />
        <ui:Label text="No audio configuration found in this project." class="welcome-subtitle" />
        <ui:Label text="Click the button below to automatically generate the necessary folders, audio mixers, prefabs, and configuration files at:" class="welcome-desc" />
        <ui:Label text="Assets/Resenha Studio/SignalAudio_Setup/Resources/" class="welcome-path" />
        <ui:Button name="btn-initial-setup" text="🚀 Generate Initial Setup" class="setup-btn" />
    </ui:VisualElement>

    <ui:VisualElement name="dashboard-container" class="dashboard-container">
        <ui:VisualElement name="sidebar" class="sidebar">
            <ui:Label text="Signal Audio" class="sidebar-title" />
            
            <ui:Button name="tab-global" class="sidebar-btn sidebar-btn-active">
                <ui:VisualElement name="icon-global" class="sidebar-icon" />
                <ui:Label text="Global Settings" />
            </ui:Button>
            
            <ui:Button name="tab-music" class="sidebar-btn">
                <ui:VisualElement name="icon-music" class="sidebar-icon" />
                <ui:Label text="Music Library" />
            </ui:Button>
            
            <ui:Button name="tab-sfx" class="sidebar-btn">
                <ui:VisualElement name="icon-sfx" class="sidebar-icon" />
                <ui:Label text="SFX Library" />
            </ui:Button>
            
            <ui:Button name="tab-tools" class="sidebar-btn">
                <ui:VisualElement name="icon-tools" class="sidebar-icon" />
                <ui:Label text="Import Tools" />
            </ui:Button>

            <ui:VisualElement style="flex-grow: 1;" /> <ui:Button name="tab-help" class="sidebar-btn">
                <ui:VisualElement name="icon-help" class="sidebar-icon" />
                <ui:Label text="Tutorial &amp; Help" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement name="main-content" class="main-content">
            <ui:Label text="Dashboard initialized." class="placeholder-text" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>